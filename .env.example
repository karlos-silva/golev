# ── Database ──
DATABASE_URL=postgresql://user:pass@db:5432/dbname
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=golev_pg

# ── API ──
PORT=3333
NODE_ENV=development
# CORS: origens do front (vírgula). Produção: https://app.seudominio.com,https://seudominio.com
ALLOWED_ORIGINS=http://localhost:3000
# Opcional: legado; use ALLOWED_ORIGINS quando possível
# CORS_ORIGIN=http://localhost:3000
# Limite do body JSON/urlencoded no Fastify (bytes). Upload multipart usa stream do multer.
REQUEST_BODY_LIMIT_BYTES=1048576
JWT_SECRET=change-me-jwt-secret
JWT_REFRESH_SECRET=change-me-jwt-refresh-secret
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
# Domínio dos cookies de sessão httpOnly. Dev: vazio (host atual = localhost).
# Produção: ".seudominio.com.br" para api.* e o domínio principal compartilharem.
COOKIE_DOMAIN=

# ── Frontend ──
# URL pública do site (sitemap, robots). Produção: https://seudominio.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3333
# PostHog (analytics). Chave pública do projeto (Project Settings) — segura no client.
NEXT_PUBLIC_POSTHOG_KEY=phc_xxx
# Região do projeto: US = https://us.i.posthog.com · EU = https://eu.i.posthog.com
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# ── Stripe ──
# Server-only (NUNCA expor no client). Use sk_test_/whsec_ em dev.
STRIPE_SECRET_KEY=
# whsec_ do `stripe listen --forward-to localhost:3333/billing/webhook`.
STRIPE_WEBHOOK_SECRET=
# Preço recorrente mensal (Stripe Dashboard → Products) — allowlist server-side.
STRIPE_PRICE_ID=
# Valor mensal em centavos — usado no mandate do Pix recorrente. R$399,00 = 39900.
STRIPE_PRICE_AMOUNT_CENTS=39900
# Métodos de pagamento no checkout (csv). Ex.: 'card' ou 'card,pix'. Cada método
# precisa da capability ativa na conta Stripe (Pix exige conta BR + Pix habilitado).
STRIPE_PAYMENT_METHODS=card
# Base pública p/ success_url/cancel_url/return_url (reusa NEXT_PUBLIC_SITE_URL).
APP_URL=http://localhost:3000
# Trava-mestra: com 'false' o checkout/portal ficam inertes e o funil volta ao
# fluxo de contato por WhatsApp. Ligue ('true' nas duas) só quando for cobrar.
BILLING_ENABLED=false
NEXT_PUBLIC_BILLING_ENABLED=false
# Chave pública (segura por design). OPCIONAL: o Checkout é redirect (hosted) e o
# front NÃO usa essa chave hoje. Reservada p/ futura integração com Stripe Elements.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ── Storage ──
UPLOADS_DIR=/data/uploads

# ── Email (Resend) ──
RESEND_API_KEY=
# Remetente. Produção: use um DOMÍNIO VERIFICADO no Resend (ex.: "Go Lev <no-reply@golev.app.br>").
# O sandbox "onboarding@resend.dev" só entrega ao dono da conta Resend.
EMAIL_FROM=Go Lev <onboarding@resend.dev>

# ── Analytics ──
POSTHOG_API_KEY=

# ── Integrações: Google Calendar (OPCIONAL — só para o portal da equipe) ──
# Necessárias apenas para conectar a agenda do Google no portal (consultas).
# A API SOBE sem elas (lidas sob demanda); só o calendário fica indisponível.
# Crie um OAuth client em https://console.cloud.google.com (APIs & Services → Credentials).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Callback do OAuth — deve casar EXATAMENTE com o cadastrado no Google Console.
# Rota real da API: GET /integrations/google/callback
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3333/integrations/google/callback
# Segredo p/ cifrar (AES-256-GCM) os tokens do Google no banco. String aleatória longa.
GOOGLE_TOKEN_ENC_KEY=change-me-random-32-chars-or-more
# Base do front p/ redirecionar de volta após o OAuth (reusa NEXT_PUBLIC_SITE_URL).
APP_WEB_URL=http://localhost:3000
