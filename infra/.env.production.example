# ─────────────────────────────────────────────────────────────
# Lista canônica das chaves de PRODUÇÃO.
#
# Os secrets NÃO ficam mais em .env à mão: eles vivem no Infisical
# (projeto, env "prod"). O .env no VPS é GERADO pelo deploy via:
#   infisical export --env=prod --format=dotenv > .env
#
# Use este arquivo como referência das chaves a cadastrar no Infisical.
# As NEXT_PUBLIC_* são injetadas no BUILD (CI) via Infisical/secrets-action.
# ─────────────────────────────────────────────────────────────

# ── Imagens (GHCR) ──
# Dono do repo no GitHub. O deploy.yml publica em ghcr.io/<owner>/<PRODUCT_NAME>-web|api
GHCR_OWNER=go-lev
PRODUCT_NAME=saas
IMAGE_TAG=latest

# ── Domínio / Caddy ──
# Usado pelo Caddyfile ({$DOMAIN}). Sem https://, só o host raiz.
DOMAIN=seudominio.com.br

# ── Database ──
POSTGRES_USER=golev
POSTGRES_PASSWORD=troque-esta-senha-forte
POSTGRES_DB=golev_prod
DATABASE_URL=postgresql://golev:troque-esta-senha-forte@db:5432/golev_prod

# ── API ──
PORT=3333
NODE_ENV=production
# Origens permitidas no CORS (o front em produção)
ALLOWED_ORIGINS=https://seudominio.com.br
REQUEST_BODY_LIMIT_BYTES=1048576
JWT_SECRET=troque-por-segredo-aleatorio-longo
JWT_REFRESH_SECRET=troque-por-outro-segredo-aleatorio-longo
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# ── Frontend ──
# ATENÇÃO: variáveis NEXT_PUBLIC_* são embutidas no BUILD da imagem web (CI),
# não em runtime. Defini-las aqui só afeta server-side. Para o bundle do cliente,
# elas precisam estar disponíveis no build do GitHub Actions (ver DEPLOY.md).
NEXT_PUBLIC_SITE_URL=https://seudominio.com.br
NEXT_PUBLIC_API_URL=https://api.seudominio.com.br
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=

# ── Stripe (pagamentos) ──
# Server-only — NUNCA expor no client. Em produção use sk_live_ e o whsec_ do
# endpoint de webhook registrado no Stripe Dashboard (≠ o do `stripe listen`).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Preço recorrente mensal (Stripe Dashboard → Products) — allowlist server-side.
STRIPE_PRICE_ID=
# Valor mensal em centavos — usado no mandate do Pix recorrente.
STRIPE_PRICE_AMOUNT_CENTS=
# Métodos no checkout (csv): 'card' ou 'card,pix' (Pix exige capability ativa).
STRIPE_PAYMENT_METHODS=card,pix
# Base pública p/ success_url/cancel_url/return_url do checkout/portal.
APP_URL=https://seudominio.com.br
# Trava-mestra: mantenha 'false' até estar pronto para cobrar de verdade.
# Com 'false', deploy é seguro (checkout inerte + funil em modo WhatsApp).
BILLING_ENABLED=false
NEXT_PUBLIC_BILLING_ENABLED=false
# Chave pública (vai pro BUILD do front via CI). Segura por design.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ── Storage ──
UPLOADS_DIR=/data/uploads

# ── Email (opcional) ──
RESEND_API_KEY=
