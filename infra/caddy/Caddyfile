# TLS de origem via Cloudflare Origin Certificate (15 anos).
# Cloudflare faz o TLS de borda + CDN; o Caddy só apresenta o cert de origem.
# Modo SSL/TLS no painel Cloudflare: Full (strict).
# Os arquivos abaixo são montados a partir de ./caddy/certs (NÃO versionados).

{$DOMAIN} {
    tls /etc/caddy/certs/origin.pem /etc/caddy/certs/origin.key

    handle /_next/static/* {
        header Cache-Control "public, max-age=31536000, immutable"
        reverse_proxy web:3000
    }
    handle {
        reverse_proxy web:3000
    }
}

api.{$DOMAIN} {
    tls /etc/caddy/certs/origin.pem /etc/caddy/certs/origin.key
    reverse_proxy api:3333
}

# ── Preview efêmero (slot único, opt-in via label `preview` no PR) ──
# Os upstreams preview-web/preview-api só existem quando há um preview no ar
# (rede externa web_edge). Sem preview → 502 (esperado).
preview.{$DOMAIN} {
    tls /etc/caddy/certs/origin.pem /etc/caddy/certs/origin.key
    # Nunca indexar o preview (evita canibalizar o SEO do site real).
    header X-Robots-Tag "noindex, nofollow, noarchive, nosnippet"
    handle /robots.txt {
        header Content-Type "text/plain"
        respond "User-agent: *
Disallow: /" 200
    }
    reverse_proxy preview-web:3000
}

api-preview.{$DOMAIN} {
    tls /etc/caddy/certs/origin.pem /etc/caddy/certs/origin.key
    header X-Robots-Tag "noindex, nofollow, noarchive, nosnippet"
    reverse_proxy preview-api:3333
}
