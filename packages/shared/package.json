{
  "name": "@golev/shared",
  "version": "0.0.0",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "import": "./dist/index.js"
    },
    "./brand/tokens.css": "./brand/tokens.css",
    "./brand/fonts.css": "./brand/fonts.css",
    "./brand/mark.svg": "./brand/mark.svg",
    "./*": {
      "types": "./dist/*/index.d.ts",
      "require": "./dist/*/index.js",
      "import": "./dist/*/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "eslint",
    "test:unit": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "drizzle-orm": "^0.44.7",
    "drizzle-zod": "^0.7.1",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/node": "^22.15.2",
    "eslint": "^9.39.4",
    "globals": "^17.4.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.58.1",
    "vitest": "^3.1.2"
  }
}
