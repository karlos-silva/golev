{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "schedule": ["before 9am on monday"],
  "timezone": "America/Sao_Paulo",
  "labels": ["dependencies"],
  "rangeStrategy": "bump",
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 5am on monday"]
  },
  "packageRules": [
    {
      "description": "Auto-merge patches and minors when CI passes",
      "matchUpdateTypes": ["patch", "minor"],
      "automerge": true,
      "automergeType": "pr",
      "automergeStrategy": "squash"
    },
    {
      "description": "Major updates require manual review",
      "matchUpdateTypes": ["major"],
      "automerge": false
    },
    {
      "description": "Group all dev dependencies",
      "matchDepTypes": ["devDependencies"],
      "groupName": "dev dependencies",
      "groupSlug": "dev-deps"
    },
    {
      "description": "Group lint and format tools",
      "matchPackageNames": [
        "eslint",
        "@eslint/js",
        "typescript-eslint",
        "prettier",
        "globals"
      ],
      "groupName": "lint and format",
      "groupSlug": "lint-format"
    },
    {
      "description": "Group testing tools",
      "matchPackageNames": [
        "vitest",
        "@playwright/test",
        "@vitest/coverage-v8"
      ],
      "groupName": "testing tools",
      "groupSlug": "testing"
    },
    {
      "description": "Group NestJS packages",
      "matchPackagePatterns": ["^@nestjs/"],
      "groupName": "nestjs",
      "groupSlug": "nestjs"
    },
    {
      "description": "Group Drizzle packages",
      "matchPackagePatterns": ["^drizzle-"],
      "groupName": "drizzle",
      "groupSlug": "drizzle"
    },
    {
      "description": "Group React/Next ecosystem",
      "matchPackageNames": [
        "next",
        "react",
        "react-dom",
        "@types/react",
        "@types/react-dom"
      ],
      "groupName": "react and next",
      "groupSlug": "react-next"
    }
  ]
}
